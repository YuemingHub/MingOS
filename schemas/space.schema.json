{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingos.cn/schemas/space.schema.json",
  "title": "MingOS Space",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "space_id", "space_type", "name", "owner_actor_id", "purpose", "lifecycle", "boundaries"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "kind": { "const": "space" },
    "space_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "space_type": { "enum": ["personal", "family", "professional", "team", "custom"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "owner_actor_id": { "type": "string", "minLength": 1 },
    "member_actor_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "default": [] },
    "purpose": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["draft", "active", "paused", "archived"] },
    "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "foundation_repository": { "type": "string" },
    "domain_repository": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
