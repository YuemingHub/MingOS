{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingos.cn/schemas/continuity-bundle.schema.json",
  "title": "MingOS Continuity Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "bundle_id",
    "space_id",
    "source_revision",
    "next_actor_id",
    "artifacts",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "kind": { "const": "continuity-bundle" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "space_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 7 },
    "next_actor_id": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifact_kind", "artifact_ids"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "artifact_kind": {
            "enum": [
              "state",
              "space",
              "actor",
              "authorization",
              "intent-contract",
              "context-ledger",
              "task",
              "evidence",
              "handoff",
              "source-conflict-report",
              "source-review"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "created_at": { "type": "string" }
  }
}
