{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingos.cn/schemas/actor.schema.json",
  "title": "MingOS Actor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "actor_id", "actor_type", "name", "roles", "accountability"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "kind": { "const": "actor" },
    "actor_id": { "type": "string", "minLength": 1 },
    "actor_type": { "enum": ["human", "household", "organization", "ai_agent", "service"] },
    "name": { "type": "string", "minLength": 1 },
    "roles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
    "accountability": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean", "default": true }
  }
}
