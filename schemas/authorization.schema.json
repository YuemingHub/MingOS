{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingos.cn/schemas/authorization.schema.json",
  "title": "MingOS Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "authorization_id",
    "space_id",
    "granted_by_actor_id",
    "granted_to_actor_id",
    "allowed_actions",
    "resource_scope",
    "requires_step_approval",
    "irreversible_actions_allowed",
    "revocable",
    "status",
    "effective_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "authorization"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "space_id": {
      "type": "string",
      "minLength": 1
    },
    "granted_by_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "granted_to_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resource_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requires_step_approval": {
      "type": "boolean"
    },
    "irreversible_actions_allowed": {
      "type": "boolean"
    },
    "budget_limit": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "revocable": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ]
    },
    "effective_at": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
