{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingos.cn/schemas/intent-contract.schema.json",
  "title": "MingOS Intent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "intent_id", "space_id", "original_expression", "current_understanding", "goals", "non_goals", "constraints", "definition_of_done", "human_decisions", "risk_level", "status", "next_action"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "kind": { "const": "intent-contract" },
    "intent_id": { "type": "string", "minLength": 1 },
    "space_id": { "type": "string", "minLength": 1 },
    "original_expression": { "type": "string", "minLength": 1 },
    "current_understanding": { "type": "string", "minLength": 1 },
    "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "definition_of_done": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "human_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "allowed_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "status": { "enum": ["draft", "confirmed", "active", "paused", "completed", "revoked"] },
    "next_action": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1, "default": 1 }
  }
}
